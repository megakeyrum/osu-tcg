{
  "name": "osu-tcg",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osu-tcg",
      "database_id": "6b535aed-145f-43ce-b3dd-0706bedc2a63",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OWNER_OSU_ID": "15336211",
    "SITE_URL": "https://osu-tcg.megakeyrum.workers.dev",
    "OSU_CLIENT_ID": "73466"
  }
}
