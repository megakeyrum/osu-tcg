{
  "name": "osu-tcg",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "osu-tcg",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OWNER_OSU_ID": "15336211",
    "SITE_URL": "https://REPLACE_WITH_YOUR_WORKER_URL",
    "OSU_CLIENT_ID": ""
  }
}
